<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:WebExpress.WebIndex.WiUI.Localization" xmlns:model="clr-namespace:WebExpress.WebIndex.WiUI.Model"
 x:Class="WebExpress.WebIndex.WiUI.Pages.ProjectPage" Title="{x:Static loc:AppText.Projects}" Shell.NavBarIsVisible="False" BackgroundColor="#1E1E1E">
 <ContentPage.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource CompactButton}">
   <Setter Property="BackgroundColor" Value="#333337" /><Setter Property="TextColor" Value="#D4D4D4" />
   <Setter Property="FontSize" Value="13" /><Setter Property="CornerRadius" Value="0" />
   <Setter Property="Padding" Value="10,4" /><Setter Property="MinimumHeightRequest" Value="30" />
  </Style>
 </ContentPage.Resources>
 <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">
  <Grid Padding="12,8" BackgroundColor="#2D2D30" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
   <Label Text="{x:Static loc:AppText.ProjectsHeading}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
   <ActivityIndicator x:Name="ProjectBusy" Grid.Column="3" IsVisible="False" Color="#4FC1FF" WidthRequest="32" HeightRequest="32" /><Button x:Name="AddProjectButton" Grid.Column="1" Text="{x:Static loc:AppText.AddProjectButton}" Clicked="OnAdd" />
   <Button Grid.Column="2" Text="{x:Static loc:AppText.BackToIndexExplorer}" Clicked="OnExplorer" />
  </Grid>
  <Grid x:Name="ProjectWorkspace" Grid.Row="1" ColumnDefinitions="290,*" ColumnSpacing="8">
   <Border BackgroundColor="#252526" Stroke="#3F3F46" Padding="8">
    <CollectionView x:Name="ProjectsList" SelectionMode="Single" SelectionChanged="OnSelected">
     <CollectionView.EmptyView><Label Text="{x:Static loc:AppText.CreateAProjectToGroupIndexFilesAndDurableDocumentLinks}" Padding="12" /></CollectionView.EmptyView>
     <CollectionView.ItemTemplate><DataTemplate x:DataType="model:Project"><VerticalStackLayout Padding="10" Spacing="4"><Label Text="{Binding ProjectName}" FontAttributes="Bold" /><Label Text="{Binding IndexPath}" FontSize="11" TextColor="#A0A0A0" LineBreakMode="MiddleTruncation" /></VerticalStackLayout></DataTemplate></CollectionView.ItemTemplate>
    </CollectionView>
   </Border>
   <ScrollView Grid.Column="1">
    <VerticalStackLayout Padding="20" Spacing="12" MaximumWidthRequest="1000" HorizontalOptions="Fill">
     <Label Text="{x:Static loc:AppText.ProjectProperties}" FontSize="20" />
     <Label Text="{x:Static loc:AppText.ProjectPropertiesDescription}" TextColor="#A0A0A0" />
     <Label Text="{x:Static loc:AppText.Name}" FontAttributes="Bold" />
     <Entry x:Name="NameInput" Placeholder="{x:Static loc:AppText.MyIndexes}" />
     <Label Text="{x:Static loc:AppText.DiscoveryFolderOptional}" FontAttributes="Bold" />
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Entry x:Name="PathInput" Placeholder="{x:Static loc:AppText.FolderContainingIndexSchemas}" /><Button Grid.Column="1" Text="{x:Static loc:AppText.Browse}" Clicked="OnBrowse" /></Grid>
     <Label Text="{x:Static loc:AppText.DiscoveryFolderDescription}" FontSize="12" TextColor="#A0A0A0" />
     <HorizontalStackLayout Spacing="8"><Button x:Name="SaveButton" Text="{x:Static loc:AppText.SaveProject}" BackgroundColor="#007ACC" TextColor="White" Clicked="OnSave" IsEnabled="False" /></HorizontalStackLayout>
     <BoxView HeightRequest="1" Color="#3F3F46" Margin="0,12" />
     <Grid ColumnDefinitions="*,Auto"><Label Text="{x:Static loc:AppText.LinkedIndexes}" FontSize="16" VerticalOptions="Center" /><Button x:Name="AddIndexButton" Grid.Column="1" Text="{x:Static loc:AppText.LinkIndex}" Clicked="OnAddIndex" IsEnabled="False" /></Grid>
     <VerticalStackLayout x:Name="LinkedIndexes" Spacing="6" />
     <Label Text="{x:Static loc:AppText.ProjectLinksDescription}" FontSize="12" TextColor="#A0A0A0" />
    </VerticalStackLayout>
   </ScrollView>
  </Grid>
  <Label x:Name="StatusLabel" Grid.Row="2" Text="{x:Static loc:AppText.SelectAProjectToEditItsProperties}" BackgroundColor="#007ACC" TextColor="White" Padding="10,5" FontSize="12" />
 </Grid>
</ContentPage>
