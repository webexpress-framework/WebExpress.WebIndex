<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WebExpress.WebIndex.WiUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:WebExpress.WebIndex.WiUI.Localization"
    xmlns:local="clr-namespace:WebExpress.WebIndex.WiUI.Pages"
    Title="WebIndex Explorer"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Index-Explorer"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="{x:Static loc:AppText.Projects}"
        ContentTemplate="{DataTemplate local:ProjectPage}"
        Route="ProjectPage" />

</Shell>
