<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<OutputType>Library</OutputType>
		<Title>WebExpress.WebIndex</Title>
		<Version>2.0.0.0</Version>
		<AssemblyVersion>2.0.0.0</AssemblyVersion>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>any</RuntimeIdentifiers>
		<RepositoryUrl>https://github.com/webexpress-framework/WebExpress.WebIndex</RepositoryUrl>
		<Authors>webexpress-framework@outlook.com</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Company>webexpress-framework@outlook.com</Company>
		<EnableDynamicLoading>true</EnableDynamicLoading>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Provide a reverse index for the WebExpress web server.</Description>
		<PackageVersion>2.0.0-alpha</PackageVersion>
		<PackageProjectUrl>https://github.com/webexpress-framework/WebExpress</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<PackageTags>webexpress</PackageTags>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<PropertyGroup>
		<!-- under Visual Studio the package would start its sbom-tool.exe, which requires the .NET 8 runtime; GenerateSbomWithDotnet hands the work to the dotnet msbuild instead -->
		<GenerateSbom Condition="'$(MSBuildRuntimeType)' == 'Core' AND '$(Configuration)' == 'Release'">true</GenerateSbom>
		<SbomGenerationPackageVersion>$(PackageVersion)</SbomGenerationPackageVersion>
		<!-- scan only the restore graph, otherwise older packages lying in bin end up as dependencies -->
		<SbomGenerationBuildComponentPath>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)</SbomGenerationBuildComponentPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Sbom.Targets" Version="4.1.13" PrivateAssets="all" />
	</ItemGroup>

  <ItemGroup>
    <Compile Remove="Assets\**" />
    <EmbeddedResource Remove="Assets\**" />
    <None Remove="Assets\**" />
  </ItemGroup>

	<ItemGroup>
		<None Remove="Asstes\IrregularWords.de" />
		<None Remove="Asstes\IrregularWords.en" />
		<None Remove="Asstes\MisspelledWords.de" />
		<None Remove="Asstes\MisspelledWords.en" />
		<None Remove="Asstes\RegularWords.de" />
		<None Remove="Asstes\RegularWords.en" />
		<None Remove="Asstes\StopWords.de" />
		<None Remove="Asstes\StopWords.en" />
		<None Remove="Asstes\Synonyms.de" />
		<None Remove="Asstes\Synonyms.en" />
		<None Remove="Internationalization\de" />
		<None Remove="Internationalization\en" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Asstes\IrregularWords.en" />
		<EmbeddedResource Include="Asstes\RegularWords.en" />
		<EmbeddedResource Include="Asstes\RegularWords.de" />
		<EmbeddedResource Include="Asstes\MisspelledWords.en" />
		<EmbeddedResource Include="Asstes\MisspelledWords.de" />
		<EmbeddedResource Include="Asstes\IrregularWords.de" />
		<EmbeddedResource Include="Asstes\StopWords.de" />
		<EmbeddedResource Include="Asstes\StopWords.en" />
		<EmbeddedResource Include="Asstes\Synonyms.de" />
		<EmbeddedResource Include="Asstes\Synonyms.en" />
		<EmbeddedResource Include="Internationalization\de" />
		<EmbeddedResource Include="Internationalization\en" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\icon.png" Link="icon.png">
	    <PackagePath>\</PackagePath>
	    <Pack>True</Pack>
	  </None>
	  <None Include="..\..\README.md" Link="README.md">
	    <PackagePath>\</PackagePath>
	    <Pack>True</Pack>
	  </None>
	  <None Include="Memory\IndexMemoryReversecs.cs" />
	</ItemGroup>

	<Target Name="GenerateSbomWithDotnet" AfterTargets="Pack" Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(IsPackable)' == 'true' AND '$(Configuration)' == 'Release'">
		<Exec Command="dotnet msbuild &quot;$(MSBuildProjectFullPath)&quot; -nologo -v:m -t:GenerateSbomTarget -p:Configuration=$(Configuration)" />
	</Target>

	<!-- Microsoft.Sbom.Targets only embeds the manifest in the nupkg; copy it next to the package as well -->
	<Target Name="CopySbomToPackageOutput" AfterTargets="GenerateSbomTarget" Condition="'$(IsPackable)' == 'true' AND '$(GenerateSbom)' == 'true'">
		<!-- set inside the target because PackageId and PackageOutputPath are only defined after the project file is evaluated -->
		<PropertyGroup>
			<SbomUnzipPath>$(IntermediateOutputPath)sbom</SbomUnzipPath>
			<SbomFileName>$(PackageId.ToLowerInvariant())</SbomFileName>
			<!-- dotnet pack -o sets PackageOutputPath without a trailing slash -->
			<SbomPackageDir>$([MSBuild]::EnsureTrailingSlash('$(PackageOutputPath)'))</SbomPackageDir>
		</PropertyGroup>
		<RemoveDir Directories="$(SbomUnzipPath)" />
		<Unzip SourceFiles="$(SbomPackageDir)$(PackageId).$(PackageVersion).nupkg" DestinationFolder="$(SbomUnzipPath)" />
		<ItemGroup>
			<SbomFile Include="$(SbomUnzipPath)\_manifest\$(SbomSpecification)\manifest.spdx.json" TargetPath="$(SbomPackageDir)$(SbomFileName).spdx.json" />
			<SbomFile Include="$(SbomUnzipPath)\_manifest\$(SbomSpecification)\manifest.spdx.json.sha256" TargetPath="$(SbomPackageDir)$(SbomFileName).spdx.json.sha256" />
		</ItemGroup>
		<Copy SourceFiles="@(SbomFile)" DestinationFiles="@(SbomFile->'%(TargetPath)')" />
		<RemoveDir Directories="$(SbomUnzipPath)" />
	</Target>

</Project>
